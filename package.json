{
  "name": "murauma",
  "version": "1.0.0",
  "private": true,
  "description": "Malayan Umamusume Racing Association — fan community site on Cloudflare Pages + D1",
  "scripts": {
    "build:css": "NODE_ENV=production npx tailwindcss -i ./css/tailwind-src.css -o ./css/tailwind.min.css --minify",
